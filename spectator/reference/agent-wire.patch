diff --git a/web/src/styles.css b/web/src/styles.css
index 387ca3b..13f424c 100644
--- a/web/src/styles.css
+++ b/web/src/styles.css
@@ -1429,3 +1429,204 @@ button {
     transition: none !important;
   }
 }
+
+
+/* ===================== AGENT WIRE (Band live feed) ===================== */
+
+.wire {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  flex: 0 0 42%;
+  max-height: 42%;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  background: linear-gradient(180deg, var(--panel-a, #121813), var(--panel-b, #0c110d));
+  overflow: hidden;
+  margin-bottom: 12px;
+}
+
+.wire__head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 10px 14px;
+  border-bottom: 1px solid var(--line);
+}
+
+.wire__title {
+  font-family: var(--font-display);
+  font-size: 17px;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+}
+
+.wire__sub {
+  font-size: 9px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.wire__sub b { color: #69b8a7; }
+
+.wire__count {
+  font-size: 10px;
+  color: var(--muted);
+  letter-spacing: 0.12em;
+  white-space: nowrap;
+}
+
+.wire__feed {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 10px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  scrollbar-width: thin;
+  scrollbar-color: var(--line) transparent;
+}
+
+.wire__empty {
+  font-size: 11px;
+  color: var(--muted);
+  padding: 14px 4px;
+}
+
+.wire__row {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  font-size: 11.5px;
+  line-height: 1.45;
+  animation: wire-rise 0.3s ease;
+}
+@keyframes wire-rise {
+  from { opacity: 0; transform: translateY(5px); }
+  to { opacity: 1; transform: none; }
+}
+
+.wire__tag {
+  flex: 0 0 auto;
+  font-size: 8px;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  padding: 2px 7px;
+  border-radius: 2px;
+  border: 1px solid var(--line);
+  color: var(--muted);
+  background: rgba(0, 0, 0, 0.35);
+}
+.wire__tag--agent {
+  color: var(--accent);
+  border-color: color-mix(in srgb, var(--accent) 55%, transparent);
+}
+
+.wire__row--dealer .wire__txt { color: #aab5aa; }
+.wire__row--agent .wire__txt { color: var(--cream, #f5f0e4); }
+
+.wire__row--summary {
+  margin: 3px 0;
+  gap: 10px;
+}
+.wire__row--summary .wire__txt {
+  flex: 0 0 auto;
+  font-size: 9.5px;
+  letter-spacing: 0.16em;
+  color: var(--muted);
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+.wire__rule {
+  flex: 1;
+  height: 1px;
+  background: var(--line);
+}
+
+/* evolution speech card */
+.wire__evo {
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--accent);
+  border-radius: 6px;
+  padding: 8px 11px;
+  background: rgba(0, 0, 0, 0.28);
+  animation: wire-rise 0.35s ease;
+}
+.wire__evo--no_change { border-left-color: #5a6b5c; }
+.wire__evo--timeout,
+.wire__evo--invalid { border-left-color: var(--bad, #f87171); }
+
+.wire__evohead {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+.wire__status {
+  font-size: 8px;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: var(--gold, #c9a227);
+}
+.wire__evo--no_change .wire__status { color: #9fb8a0; }
+.wire__evo--timeout .wire__status,
+.wire__evo--invalid .wire__status { color: var(--bad, #f87171); }
+.wire__hand {
+  margin-left: auto;
+  font-size: 9px;
+  color: var(--muted);
+}
+
+.wire__reason {
+  margin-top: 5px;
+  font-size: 11.5px;
+  line-height: 1.5;
+  color: #dde2d6;
+  font-style: italic;
+}
+
+.wire__deltas {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 6px;
+}
+.wire__delta {
+  font-size: 9.5px;
+  letter-spacing: 0.06em;
+  border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
+  border-radius: 2px;
+  padding: 2px 7px;
+  color: var(--accent);
+}
+.wire__delta i {
+  font-style: normal;
+  color: var(--muted);
+  padding: 0 3px;
+}
+
+/* typing indicator */
+.wire__dots { display: inline-flex; gap: 3px; margin-left: 6px; }
+.wire__dots i {
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: var(--accent);
+  animation: wire-blink 1.1s infinite;
+}
+.wire__dots i:nth-child(2) { animation-delay: 0.18s; }
+.wire__dots i:nth-child(3) { animation-delay: 0.36s; }
+@keyframes wire-blink {
+  0%, 100% { opacity: 0.25; }
+  40% { opacity: 1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .wire__row, .wire__evo { animation: none; }
+  .wire__dots i { animation: none; }
+}
+
+@media (max-width: 1080px) {
+  .wire { flex-basis: auto; max-height: 300px; }
+}
