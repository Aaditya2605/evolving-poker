# ---------------------------------------------------------------------------
# EVOLVING POKER — everything below is OPTIONAL.
# With no .env file at all the whole project runs in mock mode, zero network.
# ---------------------------------------------------------------------------

# --- Pioneer (LLM reflections) --------------------------------------------
# mock = deterministic scripted personas, no network, no keys (DEFAULT)
# real = OpenAI-compatible chat-completions against PIONEER_BASE_URL
PIONEER_MODE=mock
PIONEER_BASE_URL=https://api.pioneer.example/v1
PIONEER_API_KEY=

# One model per player. Pick three DIFFERENT models from Pioneer's catalog
# at kickoff — cheap / medium / stronger.
MODEL_A=qwen2.5-7b-instruct
MODEL_B=gpt-oss-20b
MODEL_C=deepseek-v3

# Optional per-model pricing for estCostUsd, USD per 1K tokens.
# Format: "<model>:<inPer1k>:<outPer1k>,<model>:<inPer1k>:<outPer1k>"
PIONEER_PRICING=

# --- Band (agent message routing) -----------------------------------------
# local = in-process routing, trace still written (DEFAULT)
# real  = route through the Band SDK
BAND_MODE=local
BAND_API_KEY=
BAND_ROOM=evolving-poker

# --- x402 (paid audit endpoint) -------------------------------------------
# test = accept the header `X-PAYMENT: test-ok` (DEFAULT)
# real = defer to real x402 middleware mounted in server/src/outputs/x402.ts
X402_MODE=test
X402_PRICE_USD=0.05
X402_PAY_TO=

# --- Server ---------------------------------------------------------------
PORT=8787
