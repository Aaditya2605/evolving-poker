# ---------------------------------------------------------------------------
# EVOLVING POKER — everything below is OPTIONAL.
# With no .env file at all the whole project runs in mock mode, zero network.
# ---------------------------------------------------------------------------

# --- Pioneer (LLM reflections) --------------------------------------------
# mock = deterministic scripted personas, no network, no keys (DEFAULT)
# real = OpenAI-compatible chat-completions against PIONEER_BASE_URL
PIONEER_MODE=mock
PIONEER_BASE_URL=https://api.pioneer.example/v1
PIONEER_API_KEY=

# One model per player. Pick three DIFFERENT models from Pioneer's catalog
# at kickoff — cheap / medium / stronger.
MODEL_A=qwen2.5-7b-instruct
MODEL_B=gpt-oss-20b
MODEL_C=deepseek-v3

# Optional per-model pricing for estCostUsd, USD per 1K tokens.
# Format: "<model>:<inPer1k>:<outPer1k>,<model>:<inPer1k>:<outPer1k>"
PIONEER_PRICING=

# --- Band (agent message routing) -----------------------------------------
# local = in-process routing, trace still written (DEFAULT)
# real  = publish hand summaries to a Band room over the Agent REST API
#
# Band is https://band.ai. Note the published `band-sdk` package is PYTHON
# (PyPI) — there is no npm build of it, so the Node server talks to the REST
# API directly. Auth is a per-agent `X-API-Key` header, NOT a bearer token.
# Docs: https://docs.band.ai/api/agent-api.md
BAND_MODE=local
BAND_BASE_URL=https://app.band.ai/api/v1/agent
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# The room to publish into. Band identifies rooms by uuid, not by name — create
# one with `POST /chats` and paste its id here.
BAND_CHAT_ID=

# Three registered Band users, one per player: 1=ATLAS, 2=BOREAS, 3=CIPHER.
# Each is its own agent account with a uuid, a handle and a key. The dealer is
# NOT a Band user — it is the in-process engine and holds no Band identity.
#
# Mentions are mandatory on every message and ARE the routing mechanism: a
# message with an empty `mentions` array reaches nobody. Band rewrites them
# server-side, so a recipient reads `@[[<uuid>]]`, not the handle — resolve
# uuid -> name yourself rather than parsing handles back out of the text.
#
# An agent cannot @mention itself, and there is no neutral fourth publisher, so
# a summary is published BY one player and addressed to the other two. Publish
# each player's own events under its own identity and the coverage works out;
# do not expect a single broadcaster to reach all three.
#
# Agents may only add siblings (same owner), global agents, or their owner to a
# room, so all three must belong to one Band account.
#
# Real values live in .env, which is gitignored. Never fill keys in here.
BAND_1_ID=
BAND_1_HANDLE=@you/hack1
BAND_1_KEY=

BAND_2_ID=
BAND_2_HANDLE=@you/hack2
BAND_2_KEY=

BAND_3_ID=
BAND_3_HANDLE=@you/hack3
BAND_3_KEY=

# --- x402 (paid audit endpoint) -------------------------------------------
# test = accept the header `X-PAYMENT: test-ok` (DEFAULT)
# real = defer to real x402 middleware mounted in server/src/outputs/x402.ts
X402_MODE=test
X402_PRICE_USD=0.05
X402_PAY_TO=

# --- Server ---------------------------------------------------------------
PORT=8787
