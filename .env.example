# Live tournaments require Pioneer inference. Mocks are test-only.
PIONEER_MODE=real
PIONEER_API_KEY=
MODEL_A=Qwen/Qwen3-4B-Instruct-2507
MODEL_B=openai/gpt-oss-20b
MODEL_C=deepseek-ai/DeepSeek-V3
MODEL_D=gemini-3-flash
# Optional comma-separated allowlist for agent-selected model migration.
MODEL_POOL=Qwen/Qwen3-4B-Instruct-2507,openai/gpt-oss-20b,deepseek-ai/DeepSeek-V3,gemini-3-flash

# Real Band routing needs four registered remote agents in one chat room.
# Messages use the per-agent key as X-API-Key and must mention recipient IDs and handles.
BAND_BASE_URL=https://app.band.ai/api/v1/agent
BAND_ROOM_ID=
BAND_AGENT_A_ID=
BAND_AGENT_A_HANDLE=
BAND_AGENT_A_API_KEY=
BAND_AGENT_B_ID=
BAND_AGENT_B_HANDLE=
BAND_AGENT_B_API_KEY=
BAND_AGENT_C_ID=
BAND_AGENT_C_HANDLE=
BAND_AGENT_C_API_KEY=
BAND_AGENT_D_ID=
BAND_AGENT_D_HANDLE=
BAND_AGENT_D_API_KEY=
