# Live tournaments require Pioneer inference. Mocks are test-only.
PIONEER_MODE=real
PIONEER_API_KEY=
MODEL_A=Qwen/Qwen3-4B-Instruct-2507
MODEL_B=openai/gpt-oss-20b
MODEL_C=deepseek-ai/DeepSeek-V3
# Optional comma-separated allowlist for agent-selected model migration.
MODEL_POOL=Qwen/Qwen3-4B-Instruct-2507,openai/gpt-oss-20b,deepseek-ai/DeepSeek-V3

# Real Band routing needs registered remote agents in one chat room.
#
# Verified against the live API: the Agent REST base is
# https://app.band.ai/api/v1/agent and it authenticates with a per-agent
# `X-API-Key` header, NOT a bearer token. The published `band-sdk` package is
# Python (PyPI) with no npm build, so this server calls REST directly.
# Docs: https://docs.band.ai/api/agent-api.md
#
# Rooms are addressed by uuid, not by name — create one with POST /chats.
BAND_ROOM_ID=

# One registered agent per player. An API key alone is NOT enough to publish:
# every message must @mention its recipients, and a mention carries the
# recipient's uuid and handle, so all three fields are needed per agent.
# Band rewrites mentions server-side, so a reader sees `@[[<uuid>]]` rather
# than the handle. An agent cannot mention itself, so a message published by a
# player is never delivered back to that player.
#
# All agents must share one Band account: an agent may only add its siblings,
# global agents, or its owner to a room.
BAND_AGENT_A_ID=
BAND_AGENT_A_HANDLE=
BAND_AGENT_A_API_KEY=

BAND_AGENT_B_ID=
BAND_AGENT_B_HANDLE=
BAND_AGENT_B_API_KEY=

BAND_AGENT_C_ID=
BAND_AGENT_C_HANDLE=
BAND_AGENT_C_API_KEY=

# Fourth player, provisioned ahead of the engine: PLAYER_IDS in shared/types.ts
# seats three, and the chip-conservation tests assume 3 x STARTING_CHIPS.
# Seating this one is an engine change, not a config change.
BAND_AGENT_D_ID=
BAND_AGENT_D_HANDLE=
BAND_AGENT_D_API_KEY=
